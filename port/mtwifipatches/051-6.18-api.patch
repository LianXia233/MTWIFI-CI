# 6.18 移植（legacy mt_wifi 767x，排在 050 之后）
#
# 1. hif_pci.c：6.18 的 struct page_frag_cache 只保留 encoded_page，
#    rx_ring->rx_page.va / pagecnt_bias 手工 drain 编译失败；>=6.18 改用
#    page_frag_cache_drain(&rx_ring->rx_page)。
# 2. mt_wifi_ap/Makefile：CONFIG_KTHREAD 在本构建中不会置 y，源码会走
#    kernel_thread() 分支（该符号在 6.18 不再导出，且 5.10 起签名变化），
#    同时 __RtmpOSTaskWaitCond 还有 #error "Not yet implemented"。强制启用
#    厂商的 KTHREAD_SUPPORT（kthread_run）分支。
# 3. netif_rx_ni() 在 6.9 移除，启用 SNIFFER_RADIOTAP 时会编译；统一换 netif_rx()。
--- a/mt_wifi_ap/Makefile
+++ b/mt_wifi_ap/Makefile
@@ -1269,6 +1269,9 @@
 ifeq ($(CONFIG_KTHREAD),y)
     EXTRA_CFLAGS += -DKTHREAD_SUPPORT
 endif
+# 6.18: kernel_thread() 已不再导出（且 5.10 起为 4 参数），厂商的
+# kthread_run 分支必须启用；CONFIG_KTHREAD 在本构建里不会置 y。
+EXTRA_CFLAGS += -DKTHREAD_SUPPORT
 
 ifeq ($(CONFIG_LINUX_NET_TXQ_SUPPORT),y)
 EXTRA_CFLAGS += -DLINUX_NET_TXQ_SUPPORT
--- a/mt_wifi/embedded/common/hif_pci.c
+++ b/mt_wifi/embedded/common/hif_pci.c
@@ -16,6 +16,9 @@
 */
 
 #include "rt_config.h"
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 18, 0)
+#include <linux/page_frag_cache.h>
+#endif
 #include "common/link_list.h"
 #include "multi_hif.h"
 #ifdef RX_RPS_SUPPORT
@@ -4952,6 +4955,12 @@
 
 		NdisZeroMemory(rx_ring->Cell, RxRingSize * sizeof(RTMP_DMACB));
 
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 18, 0)
+		if (rx_ring->buf_type == DYNAMIC_PAGE_ALLOC) {
+			page_frag_cache_drain(&rx_ring->rx_page);
+			NdisZeroMemory(&rx_ring->rx_page, sizeof(rx_ring->rx_page));
+		}
+#else
 #if LINUX_VERSION_CODE > KERNEL_VERSION(4, 3, 0)
 		if (rx_ring->buf_type == DYNAMIC_PAGE_ALLOC) {
 
@@ -4964,6 +4973,7 @@
 			}
 		}
 #endif
+#endif
 
 	}
 
