 	if (pOSPkt->dev == NULL)
 		RELEASE_NDIS_PACKET(pAd, pPacket, NDIS_STATUS_FAILURE);
 	else
-		netif_rx_ni(pOSPkt);
+		netif_rx(pOSPkt);
 
 }
 #endif
--- a/mt_wifi/embedded/common/sniffer_radiotap.c
+++ b/mt_wifi/embedded/common/sniffer_radiotap.c
@@ -575,7 +575,7 @@
 	memcpy((pOSPkt->data + mtk_rt_hdr->rt_hdr.it_len - MT7615_RMAC_LENGTH), rmac_info_buffer, MT7615_RMAC_LENGTH);
 #endif
 #endif
-	netif_rx_ni(pOSPkt);
+	netif_rx(pOSPkt);
 #ifdef SNIFFER_MT7615_RMAC_INC
 	os_free_mem(rmac_info_buffer);
 #endif
@@ -1127,7 +1127,7 @@
 	pOSPkt->pkt_type = PACKET_OTHERHOST;
 	pOSPkt->protocol = __constant_htons(ETH_P_80211_RAW);
 	pOSPkt->ip_summed = CHECKSUM_NONE;
-	netif_rx_ni(pOSPkt);
+	netif_rx(pOSPkt);
 	return;
 err_free_sk_buff:
 	RELEASE_NDIS_PACKET(NULL, pRxPacket, NDIS_STATUS_FAILURE);
--- a/mt_wifi/os/linux/rt_linux.c
+++ b/mt_wifi/os/linux/rt_linux.c
@@ -40,6 +40,9 @@
 #include <linux/oom.h>
 #include <linux/netdevice.h>
 #include <linux/mm.h>
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 18, 0)
