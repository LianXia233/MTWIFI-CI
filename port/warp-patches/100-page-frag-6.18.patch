# 6.18 移植：legacy warp（warp_bm_v2.c / mcu/warp_wo.c）的 page_frag_cache 字段变更
#
# 6.18 把 struct page_frag_cache 改成 encoded_page（include/linux/page_frag_cache.h），
# 源码里的 .va / pagecnt_bias 手工 drain 全部失效。>=6.18 统一改用
# page_frag_cache_drain(&cache)；旧路径保留在 #else，辅助函数随之只在旧内核编译。
--- a/Makefile
+++ b/Makefile
@@ -1,4 +1,6 @@
 ccflags-y += $(MODULE_FLAGS) -Inet/nat -I$(PKG_BUILD_DIR)../warp -I$(PKG_BUILD_DIR)../warp/mcu -DCONFIG_WARP_VERSION=$(CONFIG_WARP_VERSION)
+# GCC 14 把三类转换/返回不匹配默认升级为错误（源码是 6.12 基线）
+ccflags-y += -Wno-error=incompatible-pointer-types -Wno-error=int-conversion -Wno-error=return-mismatch
 
 ifeq ($(CONFIG_WARP_ATC_SUPPORT), y)
 ccflags-y += -DCONFIG_WARP_ATC_SUPPORT
--- a/warp_bm_v2.c
+++ b/warp_bm_v2.c
@@ -5,6 +5,9 @@
 #include <linux/version.h>
 #include <linux/pci.h>
 #include <linux/vmalloc.h>
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 18, 0)
+#include <linux/page_frag_cache.h>
+#endif
 
 #define DYBM_RX_EXT_POLLING_CNT	(0)//(50) /*50 times of polling approximately cost 5us */
 #define TX_BM_HTH_DELAY_INT_INTERVAL	2000	/* 2 seconds */
@@ -230,6 +233,7 @@
 	return -1;
 }
 
+#if LINUX_VERSION_CODE < KERNEL_VERSION(6, 18, 0)
 static void tx_page_frag_cache_drain(struct page *page,
 								unsigned int count)
 {
@@ -240,6 +244,7 @@
 		__free_pages(page, compound_order(page));
 #endif
 }
+#endif
 
 
 /*
@@ -250,7 +255,9 @@
 {
 	struct list_head *cur = NULL, *next = NULL;
 	struct platform_device *pdev = wed->pdev;
+#if LINUX_VERSION_CODE < KERNEL_VERSION(6, 18, 0)
 	struct page *page;
+#endif
 	struct sw_conf_t *sw_conf = wed->sw_conf;
 
 	if (!res->des_buf.alloc_va)
@@ -269,7 +276,7 @@
 
 #ifdef WED_DYNAMIC_TXBM_SUPPORT
 	if (sw_conf->txbm.enable)
-		del_timer(&res->bm2high_monitor);
+		timer_delete(&res->bm2high_monitor);
 
 	list_for_each_safe(cur, next, &res->budget_head) {
 		struct wed_bm_group_info *grp = list_entry(cur, struct wed_bm_group_info, list);
@@ -283,11 +290,16 @@
 	}
 #endif	/* WED_DYNAMIC_TXBM_SUPPORT */
 
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 18, 0)
+	page_frag_cache_drain(&res->tx_page);
+	memset(&res->tx_page, 0, sizeof(res->tx_page));
+#else
 	if (res->tx_page.va) {
 		page = virt_to_page(res->tx_page.va);
 		tx_page_frag_cache_drain(page, res->tx_page.pagecnt_bias);
 		memset(&res->tx_page, 0, sizeof(res->tx_page));
 	}
+#endif
 
 	warp_dma_buf_free(pdev, &res->des_buf);
 	warp_dma_buf_free(pdev, &res->fbuf);
@@ -942,6 +954,7 @@
 }
 #endif
 
+#if LINUX_VERSION_CODE < KERNEL_VERSION(6, 18, 0)
 static inline void rx_bm_page_frag_cache_drain(struct page *page,
 								unsigned int count)
 {
@@ -951,6 +964,7 @@
 		__rx_bm_page_frag_drain(page, compound_order(page), count);
 #endif
 }
+#endif
 
 static void
 wed_rx_bm_ring_exit(
@@ -973,12 +987,17 @@
 		wed_rx_bm_dma_cb_exit(wed, &ring->cell[i]);
 
 	for (i = 0; i < 2; i++) {
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 18, 0)
+		page_frag_cache_drain(&res->rx_page[i]);
+		memset(&res->rx_page[i], 0, sizeof(res->rx_page[i]));
+#else
 		if (res->rx_page[i].va) {
 			struct page *page;
 			page = virt_to_page(res->rx_page[i].va);
 			rx_bm_page_frag_cache_drain(page, res->rx_page[i].pagecnt_bias);
 			memset(&res->rx_page[i], 0, sizeof(res->rx_page[i]));
 		}
+#endif
 	}
 
 	vfree(ring->cell);
@@ -1728,12 +1747,17 @@
 			}
 
 			for (i = 0; i < 2; i++) {
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 18, 0)
+				page_frag_cache_drain(&res->rx_page[i]);
+				memset(&res->rx_page[i], 0, sizeof(res->rx_page[i]));
+#else
 				if (res->rx_page[i].va) {
