# port-stack: wifi7
# 6.18 移植：warp 的 page_frag_cache 字段变更
#
# 6.18 把 struct page_frag_cache 从 { void *va; ... } 改成 encoded_page
# （include/linux/page_frag_cache.h），warp 里所有 ".va / pagecnt_bias"
# 手工 drain 代码都不能编译。>=6.18 统一改用导出的
# page_frag_cache_drain(&cache)（内部解码 encoded_page 并清零），
# 同时补 linux/vmalloc.h（vmalloc/vfree 在 6.18 不再隐式可见）。
--- a/package/mtk/drivers/warp/src/warp_tx_bm_v2.c
+++ b/package/mtk/drivers/warp/src/warp_tx_bm_v2.c
@@ -17,6 +17,10 @@
 #include "warp_hw.h"
 #include "wdma.h"
 #include <linux/version.h>
+#include <linux/vmalloc.h>
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 18, 0)
+#include <linux/page_frag_cache.h>
+#endif
 #include <linux/pci.h>
 
 void
@@ -160,12 +164,17 @@
 			wed_tx_bm_dma_cb_exit(wed, bm, i, &ring->cell[i]);
 	}
 
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 18, 0)
+	page_frag_cache_drain(&bm->tx_page);
+	memset(&bm->tx_page, 0, sizeof(bm->tx_page));
+#else
 	if (bm->tx_page.va) {
 		struct page *page;
 		page = virt_to_page(bm->tx_page.va);
 		tx_bm_page_frag_cache_drain(page, bm->tx_page.pagecnt_bias);
 		memset(&bm->tx_page, 0, sizeof(bm->tx_page));
 	}
+#endif
 
 	if (ring->cell)
 		vfree(ring->cell);
