From: MTWIFI-CI port <port@localhost>
Subject: [PATCH] net: tunnel: let HNAT see DS-Lite / 6RD virtual interfaces

HNAT 需要知道一条流是否从隧道虚接口进入，才能在绑表时把外层报文按
"已封装" 处理，而不是把外层五元组当成普通 VLAN 报文绑进 FOE。

6.18 适配要点：
1. ip6_tnl_netdev_ops 的成员表与 6.12 不同（6.18 没有 ndo_ip6_tnl_flow_offload，
   ndo_change_mtu 位置也不同），按 6.18 的真实成员表重新落位。
2. 6.18 的 struct ip6_tnl / struct ip_tunnel 里的 dev 字段指向隧道设备自身，
   不是它依附的链路设备；6.12 版本里的 path->dev = tnl->dev 在 6.18 下是
   自指（等于没改），也没有别的字段能等价给出链路设备。因此改为只置类型位、
   并把当前隧道设备记进 virt_dev，语义上等价于原实现的可观察行为，
   同时不会再写出一个指向自身的 path->dev。
---
diff --git a/include/net/netfilter/nf_flow_table.h b/include/net/netfilter/nf_flow_table.h
--- a/include/net/netfilter/nf_flow_table.h
+++ b/include/net/netfilter/nf_flow_table.h
@@ -190,6 +190,7 @@
 
 struct flow_offload_hw_path {
 	struct net_device *dev;
+	struct net_device *virt_dev;
 	u32 flags;
 
 	u8 eth_src[ETH_ALEN];
diff --git a/net/8021q/vlan_dev.c b/net/8021q/vlan_dev.c
--- a/net/8021q/vlan_dev.c
+++ b/net/8021q/vlan_dev.c
@@ -998,6 +998,7 @@
 	path->flags |= BIT(DEV_PATH_VLAN);
 	path->vlan_proto = vlan->vlan_proto;
 	path->vlan_id = vlan->vlan_id;
+	path->virt_dev = dev;
 	path->dev = vlan->real_dev;
 
 	if (vlan->real_dev->netdev_ops->ndo_flow_offload_check)
diff --git a/net/ipv6/ip6_tunnel.c b/net/ipv6/ip6_tunnel.c
--- a/net/ipv6/ip6_tunnel.c
+++ b/net/ipv6/ip6_tunnel.c
@@ -56,6 +56,11 @@
 #include <net/dst_metadata.h>
 #include <net/inet_dscp.h>
 
+#if IS_ENABLED(CONFIG_NF_FLOW_TABLE)
+#include <linux/netfilter.h>
+#include <net/netfilter/nf_flow_table.h>
+#endif
+
 MODULE_AUTHOR("Ville Nuorvala");
 MODULE_DESCRIPTION("IPv6 tunneling device");
 MODULE_LICENSE("GPL");
@@ -1775,6 +1780,21 @@
 }
 EXPORT_SYMBOL(ip6_tnl_get_iflink);
 
+#if IS_ENABLED(CONFIG_NF_FLOW_TABLE)
+static int ip6_tnl_flow_offload_check(struct flow_offload_hw_path *path)
+{
+	struct net_device *dev = path->dev;
+
+	if (path->flags & BIT(DEV_PATH_DSLITE))
+		return -EEXIST;
+
+	path->flags |= BIT(DEV_PATH_DSLITE);
+	path->virt_dev = dev;
+
+	return 0;
+}
+#endif /* CONFIG_NF_FLOW_TABLE */
+
 int ip6_tnl_encap_add_ops(const struct ip6_tnl_encap_ops *ops,
 			  unsigned int num)
 {
@@ -1833,6 +1853,9 @@
 	.ndo_uninit	= ip6_tnl_dev_uninit,
 	.ndo_start_xmit = ip6_tnl_start_xmit,
 	.ndo_siocdevprivate = ip6_tnl_siocdevprivate,
+#if IS_ENABLED(CONFIG_NF_FLOW_TABLE)
+	.ndo_flow_offload_check = ip6_tnl_flow_offload_check,
+#endif
 	.ndo_change_mtu = ip6_tnl_change_mtu,
 	.ndo_get_stats64 = dev_get_tstats64,
 	.ndo_get_iflink = ip6_tnl_get_iflink,
diff --git a/net/ipv6/sit.c b/net/ipv6/sit.c
--- a/net/ipv6/sit.c
+++ b/net/ipv6/sit.c
@@ -54,6 +54,11 @@
 #include <net/netdev_lock.h>
 #include <net/inet_dscp.h>
 
+#if IS_ENABLED(CONFIG_NF_FLOW_TABLE)
+#include <linux/netfilter.h>
+#include <net/netfilter/nf_flow_table.h>
+#endif
+
 /*
    This version of net/ipv6/sit.c is cloned of net/ipv4/ip_gre.c
 
@@ -1391,12 +1396,30 @@
 	}
 }
 
+#if IS_ENABLED(CONFIG_NF_FLOW_TABLE)
+static int ipip6_dev_flow_offload_check(struct flow_offload_hw_path *path)
+{
+	struct net_device *dev = path->dev;
+
+	if (path->flags & BIT(DEV_PATH_6RD))
+		return -EEXIST;
+
+	path->flags |= BIT(DEV_PATH_6RD);
+	path->virt_dev = dev;
+
+	return 0;
+}
+#endif /* CONFIG_NF_FLOW_TABLE */
+
 static const struct net_device_ops ipip6_netdev_ops = {
 	.ndo_init	= ipip6_tunnel_init,
 	.ndo_uninit	= ipip6_tunnel_uninit,
 	.ndo_start_xmit	= sit_tunnel_xmit,
 	.ndo_siocdevprivate = ipip6_tunnel_siocdevprivate,
 	.ndo_get_iflink = ip_tunnel_get_iflink,
+#if IS_ENABLED(CONFIG_NF_FLOW_TABLE)
+	.ndo_flow_offload_check = ipip6_dev_flow_offload_check,
+#endif
 	.ndo_tunnel_ctl = ipip6_tunnel_ctl,
 };
 
