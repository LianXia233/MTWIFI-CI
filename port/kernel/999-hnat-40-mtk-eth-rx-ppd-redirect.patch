Subject: [PATCH] net: ethernet: mediatek: 支持把收回的报文交还给 rx ppd 设备

6.18 适配（本仓库维护）：

硬件在部分路径上会把已经送出 CPU 的报文再送回接收环（sport 为 QDMA TX
端口，或 WDMA 端口 + force-to-cpu 原因码），这些报文不属于收到它的那块
GDM 网卡，而属于外部设备直通口，需要交还给 HNAT 指定的 rx ppd 设备。

- 新增 g_rx_ppdev 全局指针并由 HNAT 侧维护其生命周期，本文件只读；
- 收包路径记录 sport，QDMA TX 端口与 WDMA+force-to-cpu 两种情形标记
  to_ppd；
- 6.18 的 mtk_poll_rx() 在 eth_type_trans() 之前就已确定 netdev，
  因此重定向在该处替换 netdev，而不是事后覆盖 skb->dev / skb->protocol
  （那样 eth 头已被摘下，重新取 h_proto 会读到载荷）。

---

diff --git a/drivers/net/ethernet/mediatek/mtk_eth_soc.c b/drivers/net/ethernet/mediatek/mtk_eth_soc.c
--- a/drivers/net/ethernet/mediatek/mtk_eth_soc.c
+++ b/drivers/net/ethernet/mediatek/mtk_eth_soc.c
@@ -313,6 +313,10 @@
 	"top_netsys_warp_sel",
 };
 
+/* Rx PPD 直通设备，由 HNAT 使能 rx ppd 时写入，本驱动只读取 */
+struct net_device *g_rx_ppdev;
+EXPORT_SYMBOL(g_rx_ppdev);
+
 void mtk_w32(struct mtk_eth *eth, u32 val, unsigned reg)
 {
 	__raw_writel(val, eth->base + reg);
@@ -2493,12 +2497,17 @@
 	int done = 0, bytes = 0;
 	dma_addr_t dma_addr = DMA_MAPPING_ERROR;
 	int ppe_idx = 0;
+	struct net_device *rx_ppdev;
+
+	rx_ppdev = READ_ONCE(g_rx_ppdev);
 
 	while (done < budget) {
 		unsigned int pktlen, *rxdcsum;
 		struct net_device *netdev;
 		u32 hash, reason;
+		u32 sport = 0;
 		int mac = 0;
+		bool to_ppd = false;
 
 		ring = mtk_get_rx_ring(eth);
 		if (unlikely(!ring))
@@ -2513,30 +2522,55 @@
 
 		/* find out which mac the packet come from. values start at 1 */
 		if (mtk_is_netsys_v3_or_greater(eth)) {
-			u32 val = RX_DMA_GET_SPORT_V2(trxd.rxd5);
+			sport = RX_DMA_GET_SPORT_V2(trxd.rxd5);
 
-			switch (val) {
+			switch (sport) {
 			case PSE_GDM1_PORT:
 			case PSE_GDM2_PORT:
-				mac = val - 1;
+				mac = sport - 1;
 				break;
 			case PSE_GDM3_PORT:
 				mac = MTK_GMAC3_ID;
 				break;
+			case PSE_QDMA_TX_PORT:
+			case PSE_WDMA0_PORT:
+			case PSE_WDMA1_PORT:
+			case PSE_WDMA2_PORT:
+				to_ppd = true;
+				break;
 			default:
 				break;
 			}
 		} else if (!MTK_HAS_CAPS(eth->soc->caps, MTK_SOC_MT7628) &&
 			   !(trxd.rxd4 & RX_DMA_SPECIAL_TAG)) {
-			mac = RX_DMA_GET_SPORT(trxd.rxd4) - 1;
+			sport = RX_DMA_GET_SPORT(trxd.rxd4);
+			mac = sport - 1;
+
+			if (sport == PSE_QDMA_TX_PORT ||
+			    sport == PSE_WDMA0_PORT ||
+			    sport == PSE_WDMA1_PORT ||
+			    sport == PSE_WDMA2_PORT)
+				to_ppd = true;
 		}
 
-		if (unlikely(mac < 0 || mac >= MTK_MAX_DEVS ||
-			     !eth->netdev[mac]))
+		/*
+		 * 从 QDMA TX 口收回的报文是 CPU 自己发出的，从 WDMA 口回来的报文
+		 * 由 WED 卸载，两者都没有对应的 GDM 网卡；它们只能交给 rx ppd
+		 * 设备。该设备由 HNAT 在使能 rx ppd 时注册，未注册时丢弃。
+		 */
+		if (unlikely(to_ppd && !rx_ppdev))
 			goto release_desc;
 
-		netdev = eth->netdev[mac];
-		ppe_idx = eth->mac[mac]->ppe_idx;
+		if (unlikely(to_ppd)) {
+			netdev = rx_ppdev;
+		} else {
+			if (unlikely(mac < 0 || mac >= MTK_MAX_DEVS ||
+				     !eth->netdev[mac]))
+				goto release_desc;
+
+			netdev = eth->netdev[mac];
+			ppe_idx = eth->mac[mac]->ppe_idx;
+		}
 
 		if (unlikely(test_bit(MTK_RESETTING, &eth->state)))
 			goto release_desc;
