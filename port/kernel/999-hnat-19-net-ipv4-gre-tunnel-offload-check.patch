From: MTWIFI-CI port <port@localhost>
Subject: [PATCH] net: ipv4: gre: report GRETAP tunnel path to hardware flow offload

GRETAP 口需要一个 ndo_flow_offload_check 实现，把隧道类型与真实出接口
写进 flow_offload_hw_path，硬件流表才能对封装/解封装流量做卸载。
补丁按 6.18 的 gre_tap_netdev_ops 现状编写（stats64 已改为 dev_get_tstats64）。

---
diff --git a/net/ipv4/ip_gre.c b/net/ipv4/ip_gre.c
--- a/net/ipv4/ip_gre.c
+++ b/net/ipv4/ip_gre.c
@@ -40,6 +40,7 @@
 #include <net/inet_ecn.h>
 #include <net/xfrm.h>
 #include <net/net_namespace.h>
+#include <net/netfilter/nf_flow_table.h>
 #include <net/netns/generic.h>
 #include <net/rtnetlink.h>
 #include <net/gre.h>
@@ -975,6 +976,28 @@
 	return 0;
 }
 #endif
+
+#if IS_ENABLED(CONFIG_NF_FLOW_TABLE)
+/* GRETAP 属于二层隧道：硬件流表需要知道隧道类型才能选对 TOPS 表项，
+ * 并把路径切换到承载隧道的真实设备（virt_dev 保留 GRETAP 口本身，
+ * 供后续取 MAC）。已经标记过隧道就不再重复设置，避免多层封装互相覆盖。
+ */
+static int gre_dev_flow_offload_check(struct flow_offload_hw_path *path)
+{
+	struct net_device *dev = path->dev;
+	struct ip_tunnel *tunnel = netdev_priv(dev);
+
+	if (path->flags & BIT(DEV_PATH_TNL))
+		return -EEXIST;
+
+	path->flags |= BIT(DEV_PATH_TNL);
+	path->tnl_type = FLOW_OFFLOAD_TNL_GRETAP;
+	path->virt_dev = dev;
+	path->dev = tunnel->dev;
+
+	return 0;
+}
+#endif /* CONFIG_NF_FLOW_TABLE */
 
 static const struct net_device_ops ipgre_netdev_ops = {
 	.ndo_init		= ipgre_tunnel_init,
@@ -1344,6 +1367,9 @@
 	.ndo_get_stats64	= dev_get_tstats64,
 	.ndo_get_iflink		= ip_tunnel_get_iflink,
 	.ndo_fill_metadata_dst	= gre_fill_metadata_dst,
+#if IS_ENABLED(CONFIG_NF_FLOW_TABLE)
+	.ndo_flow_offload_check = gre_dev_flow_offload_check,
+#endif
 };
 
 static int erspan_tunnel_init(struct net_device *dev)
