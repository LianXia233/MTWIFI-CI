From: MTWIFI-CI port <port@localhost>
Subject: [PATCH] net: ppp: pptp: report PPTP channel to hardware flow offload

PPTP 通道同样需要上报隧道类型，硬件才能对 GRE 承载的 PPP 流量做卸载。
6.18 的 pptp_chan_ops 只有 start_xmit / ioctl 两项，补丁按现状追加。

---
diff --git a/drivers/net/ppp/pptp.c b/drivers/net/ppp/pptp.c
--- a/drivers/net/ppp/pptp.c
+++ b/drivers/net/ppp/pptp.c
@@ -34,6 +34,7 @@
 #include <net/route.h>
 #include <net/gre.h>
 #include <net/pptp.h>
+#include <net/netfilter/nf_flow_table.h>
 
 #include <linux/uaccess.h>
 
@@ -145,6 +146,29 @@
 
 	return ip_route_output_flow(net, fl4, sk);
 }
+
+#if IS_ENABLED(CONFIG_NF_FLOW_TABLE)
+/* PPTP 走 GRE 承载 PPP 帧，硬件按独立的 TOPS 表项处理；套接字已断开时
+ * 不产生卸载路径，避免把死会话的流表项下发到硬件。
+ */
+static int pptp_flow_offload_check(struct ppp_channel *chan,
+				   struct flow_offload_hw_path *path)
+{
+	struct sock *sk = chan->private;
+	struct pppox_sock *po = pppox_sk(sk);
+
+	if (path->flags & BIT(DEV_PATH_TNL))
+		return -EEXIST;
+
+	if (sk_pppox(po)->sk_state & PPPOX_DEAD)
+		return -EINVAL;
+
+	path->flags |= BIT(DEV_PATH_TNL);
+	path->tnl_type = FLOW_OFFLOAD_TNL_PPTP;
+
+	return 0;
+}
+#endif /* CONFIG_NF_FLOW_TABLE */
 
 static int pptp_xmit(struct ppp_channel *chan, struct sk_buff *skb)
 {
@@ -611,6 +635,9 @@
 static const struct ppp_channel_ops pptp_chan_ops = {
 	.start_xmit = pptp_xmit,
 	.ioctl      = pptp_ppp_ioctl,
+#if IS_ENABLED(CONFIG_NF_FLOW_TABLE)
+	.flow_offload_check = pptp_flow_offload_check,
+#endif /* CONFIG_NF_FLOW_TABLE */
 };
 
 static struct proto pptp_sk_proto __read_mostly = {
